---
import type { Addin } from '../data/addins';

interface Props {
  addin: Addin;
}

const { addin } = Astro.props;
const priceLabel = addin.pricing === 'free' ? 'Free' : 'Paid';
---

<li class="relative w-72 shrink-0 snap-start rounded-lg border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm focus-within:ring-2 focus-within:ring-slate-900">
  <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
    {priceLabel}
  </p>
  <h3 class="mt-1 text-lg font-semibold text-slate-900">
    <a
      class="after:absolute after:inset-0 focus:outline-none"
      href={`/${addin.slug}/`}
    >
      {addin.name}
    </a>
  </h3>
  <p class="mt-2 text-sm text-slate-600">{addin.tagline}</p>
  <p class="mt-4 text-sm font-medium text-slate-900">
    View details <span aria-hidden="true">&rarr;</span>
  </p>
</li>
