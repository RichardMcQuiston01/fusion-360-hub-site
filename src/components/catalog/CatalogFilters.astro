---
import {
  CATALOG_SORTS,
  type CatalogFacet,
  type CatalogGroup,
  type CatalogItem,
} from '../../lib/catalog';

interface Props {
  idPrefix: string;
  facets: CatalogFacet[];
  groups: CatalogGroup[];
  items: CatalogItem[];
  searchLabel: string;
}

const { idPrefix, facets, groups, items, searchLabel } = Astro.props;

// The group filter is built in: one option per group that has items.
const groupFacet: CatalogFacet = {
  key: 'group',
  label: 'Group',
  options: groups
    .filter((group) => items.some((item) => item.group === group.slug))
    .map((group) => ({ value: group.slug, label: group.name })),
};
const allFacets = [...facets, groupFacet];

function countFor(key: string, value: string): number {
  return items.filter((item) =>
    key === 'group' ? item.group === value : item.facets[key] === value
  ).length;
}
---

<form
  data-catalog-form
  role="search"
  aria-label={searchLabel}
  action=""
  method="get"
  class="flex flex-col gap-5 group-data-[layout=toolbar]/catalog:sm:flex-row group-data-[layout=toolbar]/catalog:sm:flex-wrap group-data-[layout=toolbar]/catalog:sm:items-end"
>
  <div class="group-data-[layout=toolbar]/catalog:sm:w-72">
    <label
      for={`${idPrefix}-search`}
      class="mb-1 block text-sm font-semibold text-ink"
    >
      {searchLabel}
    </label>
    <input
      id={`${idPrefix}-search`}
      name="q"
      type="search"
      autocomplete="off"
      class="min-h-11 w-full rounded-md border-2 border-control bg-surface px-3 text-ink"
      data-catalog-search
    />
  </div>

  <div class="group-data-[layout=toolbar]/catalog:sm:w-56">
    <label
      for={`${idPrefix}-sort`}
      class="mb-1 block text-sm font-semibold text-ink"
    >
      Sort by
    </label>
    <select
      id={`${idPrefix}-sort`}
      name="sort"
      class="min-h-11 w-full rounded-md border-2 border-control bg-surface px-3 text-ink"
      data-catalog-sort
    >
      {CATALOG_SORTS.map((sort) => (
        <option value={sort.value}>{sort.label}</option>
      ))}
    </select>
  </div>

  <button
    type="button"
    data-catalog-filters-toggle
    aria-expanded="false"
    aria-controls={`${idPrefix}-facets`}
    class="hidden min-h-10 items-center gap-2 self-start group-data-[layout=toolbar]/catalog:sm:self-end rounded-md border border-control bg-surface px-4 text-sm font-semibold text-ink hover:bg-accent-tint"
  >
    <span data-catalog-filters-toggle-label>Show filters</span>
  </button>

  <div
    id={`${idPrefix}-facets`}
    data-catalog-facets
    class="flex flex-col gap-5 sm:flex-row sm:flex-wrap"
  >
    {allFacets.map((facet) => (
      <fieldset class="m-0 min-w-0 border-0 p-0">
        <legend class="mb-1 text-sm font-semibold text-ink">
          {facet.label}
        </legend>
        <div class="flex flex-col gap-1">
          {facet.options.map((option) => (
            <label class="flex min-h-8 cursor-pointer items-center gap-2 text-sm text-ink">
              <input
                type="checkbox"
                class="size-5 accent-accent"
                name={facet.key}
                value={option.value}
                data-catalog-facet={facet.key}
              />
              <span>
                {option.label}{' '}
                <span class="text-muted">
                  ({countFor(facet.key, option.value)})
                </span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
  </div>

  <div>
    <button
      type="button"
      data-catalog-clear
      class="min-h-10 rounded-md border border-control bg-surface px-4 text-sm font-semibold text-ink hover:bg-accent-tint"
    >
      Clear search and filters
    </button>
  </div>
</form>
