---
import type { CatalogItem } from '../../lib/catalog';

interface Props {
  item: CatalogItem;
}

const { item } = Astro.props;

const facetAttributes = Object.fromEntries(
  Object.entries(item.facets).map(([key, value]) => [
    `data-facet-${key}`,
    value,
  ])
);
---

<li
  data-catalog-item
  data-title={item.title}
  data-added={item.addedOn}
  data-search={item.searchText.toLowerCase()}
  data-facet-group={item.group}
  {...facetAttributes}
  class="relative rounded-lg border border-border bg-surface p-5 transition hover:border-control hover:shadow-sm focus-within:ring-2 focus-within:ring-focus group-data-[view=carousel]/catalog:w-72 group-data-[view=carousel]/catalog:shrink-0 group-data-[view=carousel]/catalog:snap-start group-data-[view=list]/catalog:sm:flex group-data-[view=list]/catalog:sm:items-center group-data-[view=list]/catalog:sm:gap-6"
>
  <div class="group-data-[view=list]/catalog:sm:flex-1">
    <p class="inline-block rounded-full bg-accent-tint px-2.5 py-0.5 text-xs font-semibold text-ink">
      {item.badge}
    </p>
    <h3 class="mt-2 text-xl text-ink">
      <a
        class="text-ink no-underline after:absolute after:inset-0 hover:underline focus:outline-none"
        href={item.href}
      >
        {item.title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-muted">{item.summary}</p>
  </div>
  <p class="mt-4 text-sm font-semibold text-accent group-data-[view=list]/catalog:sm:mt-0 group-data-[view=list]/catalog:sm:shrink-0">
    View details <span aria-hidden="true">&rarr;</span>
  </p>
</li>
