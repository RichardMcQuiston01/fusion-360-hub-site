---
import AddinCard from './AddinCard.astro';
import type { Addin, AddinGroup } from '../data/addins';

interface Props {
  group: AddinGroup;
  addins: Addin[];
}

const { group, addins } = Astro.props;
const headingId = `group-${group.slug}`;
---

<section id={group.slug} aria-labelledby={headingId} class="mt-10 scroll-mt-6">
  <div class="flex items-end justify-between gap-4">
    <div>
      <h2 id={headingId} class="text-xl font-semibold text-slate-900">
        {group.name}
      </h2>
      <p class="mt-1 text-sm text-slate-600">{group.description}</p>
    </div>
    <div class="hidden gap-2" data-carousel-controls>
      <button
        type="button"
        class="rounded border border-slate-300 px-3 py-1 text-slate-700 hover:bg-slate-100 disabled:opacity-40"
        data-carousel-prev
        aria-label={`Scroll ${group.name} back`}
      >
        &larr;
      </button>
      <button
        type="button"
        class="rounded border border-slate-300 px-3 py-1 text-slate-700 hover:bg-slate-100 disabled:opacity-40"
        data-carousel-next
        aria-label={`Scroll ${group.name} forward`}
      >
        &rarr;
      </button>
    </div>
  </div>
  <ul
    class="mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2"
    data-carousel-track
    tabindex="0"
    aria-label={`${group.name} add-ins`}
  >
    {addins.map((addin) => (
      <AddinCard addin={addin} />
    ))}
  </ul>
</section>

<script>
  // Shows the arrow buttons only when a row has more cards than fit, and
  // scrolls it by one visible width at a time.
  function setUpCarousel(section: HTMLElement): void {
    const track = section.querySelector<HTMLElement>('[data-carousel-track]');
    const controls = section.querySelector<HTMLElement>(
      '[data-carousel-controls]'
    );
    const prev = section.querySelector<HTMLButtonElement>(
      '[data-carousel-prev]'
    );
    const next = section.querySelector<HTMLButtonElement>(
      '[data-carousel-next]'
    );
    if (!track || !controls || !prev || !next) {
      return;
    }

    const update = (): void => {
      const overflows = track.scrollWidth > track.clientWidth + 1;
      controls.classList.toggle('hidden', !overflows);
      controls.classList.toggle('flex', overflows);
      prev.disabled = track.scrollLeft <= 0;
      next.disabled =
        track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const scrollByPage = (direction: 1 | -1): void => {
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      track.scrollBy({
        left: direction * track.clientWidth * 0.9,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    };

    prev.addEventListener('click', () => scrollByPage(-1));
    next.addEventListener('click', () => scrollByPage(1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }

  document
    .querySelectorAll<HTMLElement>('section[aria-labelledby^="group-"]')
    .forEach(setUpCarousel);
</script>
