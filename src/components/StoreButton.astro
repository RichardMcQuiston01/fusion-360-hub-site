---
interface Props {
  storeUrl: string | null;
}

const { storeUrl } = Astro.props;
---

{storeUrl ? (
  <a
    href={storeUrl}
    class="inline-block rounded-md bg-accent px-5 py-3 font-semibold text-white no-underline hover:bg-ink"
  >
    Get it on the Autodesk App Store
  </a>
) : (
  <span class="inline-block rounded-md border border-control bg-surface px-5 py-3 font-medium text-ink">
    Coming soon to the Autodesk App Store
  </span>
)}
