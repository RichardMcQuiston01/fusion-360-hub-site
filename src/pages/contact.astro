---
import BaseLayout from '../layouts/BaseLayout.astro';
import { addins } from '../data/addins';

const contactEmail = 'fusion360@richardmcquiston.com';
const subjects = ['General Inquiry', 'Product Support', 'Other'];
const productSupportSubject = 'Product Support';
const products = addins.map((addin) => addin.name);

const fieldClass =
  'mt-1 block w-full max-w-lg rounded-md border border-control bg-surface px-3 py-2 text-ink';
---

<BaseLayout title="Contact Us | Fusion 360 Generators">
  <h1 class="text-4xl text-ink">Contact Us</h1>
  <p class="mt-4 max-w-2xl">
    Questions, bug reports and feature requests are welcome. Send us a message
    with the form below, or email
    <a class="underline" href={`mailto:${contactEmail}`}>
      {contactEmail}
    </a>
    .
  </p>

  <form
    id="contact-form"
    class="mt-8 max-w-2xl space-y-6"
    method="post"
    action="/api/contact.php"
    data-product-support={productSupportSubject}
  >
    <div>
      <label for="contact-subject" class="font-semibold text-ink">
        Subject <span aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </label>
      <select id="contact-subject" name="subject" required class={fieldClass}>
        <option value="">Choose a subject</option>
        {subjects.map((subject) => (
          <option value={subject}>{subject}</option>
        ))}
      </select>
    </div>

    <div id="contact-product-field" hidden>
      <label for="contact-product" class="font-semibold text-ink">
        Select Product <span class="font-normal text-muted">(optional)</span>
      </label>
      <select id="contact-product" name="product" class={fieldClass}>
        <option value="">Not sure or not listed</option>
        {products.map((product) => (
          <option value={product}>{product}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="contact-name" class="font-semibold text-ink">
        Your Name <span class="font-normal text-muted">(optional)</span>
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength="100"
        class={fieldClass}
      />
    </div>

    <div>
      <label for="contact-email" class="font-semibold text-ink">
        Your Email <span aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        maxlength="254"
        aria-describedby="contact-email-help"
        class={fieldClass}
      />
      <p id="contact-email-help" class="mt-1 text-sm text-muted">
        We use this only to reply to you.
      </p>
    </div>

    <div>
      <label for="contact-fusion-version" class="font-semibold text-ink">
        Fusion 360 Version
        <span class="font-normal text-muted">(optional)</span>
      </label>
      <input
        id="contact-fusion-version"
        name="fusion_version"
        type="text"
        autocomplete="off"
        maxlength="100"
        class={fieldClass}
      />
    </div>

    <div>
      <label for="contact-message" class="font-semibold text-ink">
        Message Body <span aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="8"
        required
        maxlength="5000"
        class={fieldClass}
      ></textarea>
    </div>

    <!-- Trap for spam bots; people never see or fill it in. -->
    <div class="sr-only" aria-hidden="true">
      <label for="contact-website">Leave this field empty</label>
      <input
        id="contact-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div>
      <button
        id="contact-submit"
        type="submit"
        class="rounded-md bg-accent px-5 py-3 font-semibold text-white hover:bg-ink disabled:cursor-wait disabled:bg-muted"
      >
        Send message
      </button>
      <p
        id="contact-result"
        class="mt-3 max-w-lg font-medium"
        tabindex="-1"
      ></p>
    </div>
  </form>

  <noscript>
    <p class="mt-6 max-w-2xl">
      The form needs JavaScript. Please email
      <a class="underline" href={`mailto:${contactEmail}`}>
        {contactEmail}
      </a>
      instead.
    </p>
  </noscript>

  <h2 class="mt-10 text-2xl text-ink">Before you write</h2>
  <ul class="mt-2 list-disc space-y-1 pl-6">
    <li>Say which add-in and which version you are using.</li>
    <li>Say which version of Fusion you are using, and that it is Windows.</li>
    <li>Describe the settings you used and what you expected to happen.</li>
  </ul>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const subjectSelect = document.getElementById(
    'contact-subject'
  ) as HTMLSelectElement;
  const productField = document.getElementById('contact-product-field')!;
  const productSelect = document.getElementById(
    'contact-product'
  ) as HTMLSelectElement;
  const submitButton = document.getElementById(
    'contact-submit'
  ) as HTMLButtonElement;
  const resultText = document.getElementById('contact-result')!;
  const fallbackEmail = 'fusion360@richardmcquiston.com';

  function updateProductField(): void {
    const showProduct = subjectSelect.value === form.dataset.productSupport;
    productField.hidden = !showProduct;
    if (!showProduct) {
      productSelect.value = '';
    }
  }

  function showResult(ok: boolean, message: string): void {
    resultText.textContent = message;
    resultText.className = `mt-3 max-w-lg font-medium ${ok ? 'text-free' : 'text-ink'}`;
    resultText.setAttribute('role', ok ? 'status' : 'alert');
    resultText.focus();
  }

  async function sendMessage(): Promise<void> {
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = (await response.json()) as {
        ok: boolean;
        message: string;
      };
      showResult(result.ok, result.message);
      if (result.ok) {
        form.reset();
        updateProductField();
      }
    } catch (error) {
      console.error('Contact form request failed:', error);
      showResult(
        false,
        `Sorry, we could not reach the server. Please email ${fallbackEmail} instead.`
      );
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send message';
    }
  }

  subjectSelect.addEventListener('change', updateProductField);
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void sendMessage();
  });
  updateProductField();
</script>
