---
import BaseLayout from '../layouts/BaseLayout.astro';
import GroupCarousel from '../components/GroupCarousel.astro';
import { getGroupedAddins } from '../data/addins';

const groupedAddins = getGroupedAddins();
---

<BaseLayout title="Fusion 360 Generators">
  <h1 class="text-3xl font-bold text-slate-900">Fusion 360 Generators</h1>
  <p class="mt-3 max-w-2xl text-lg text-slate-600">
    Add-ins for Autodesk Fusion that draw ready-to-cut sketches for laser
    cutters, CNC routers and 3D printers. Windows only for now.
  </p>
  {groupedAddins.map(({ group, addins }) => (
    <GroupCarousel group={group} addins={addins} />
  ))}
</BaseLayout>
