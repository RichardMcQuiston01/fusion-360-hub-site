---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreButton from '../components/StoreButton.astro';
import { addins, getGroup } from '../data/addins';

export const getStaticPaths = (() =>
  addins.map((addin) => ({
    params: { slug: addin.slug },
    props: { addin },
  }))) satisfies GetStaticPaths;

const { addin } = Astro.props;
const group = getGroup(addin.group);
const pageUrl = new URL(`/${addin.slug}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${addin.name} for Fusion 360`,
  description: addin.tagline,
  url: pageUrl,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Windows',
  offers:
    addin.pricing === 'free'
      ? { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      : undefined,
  author: { '@type': 'Person', name: 'Richard McQuiston' },
};
---

<BaseLayout
  title={`${addin.name} for Fusion 360`}
  description={addin.tagline}
  jsonLd={jsonLd}
>
  <button
    type="button"
    id="go-back"
    class="rounded-md border border-control bg-surface px-4 py-2 font-medium text-ink hover:bg-accent-tint"
  >
    &larr; Go Back
  </button>
  <noscript>
    <a class="underline" href="/">
      &larr; Back to all add-ins
    </a>
  </noscript>
  <h1 class="mt-6 text-4xl text-ink">{addin.name}</h1>
  <p class="mt-2 text-muted">
    <span class="font-semibold text-ink">Category:</span>{' '}
    <a class="underline" href={`/#${group.slug}`}>
      {group.name}
    </a>
  </p>
  <p class="mt-1 text-muted">
    <span class="font-semibold text-ink">Price:</span>{' '}
    {addin.pricing === 'free' ? 'Free' : 'Paid'}
  </p>
  <p class="mt-4 max-w-2xl text-lg text-muted">{addin.description}</p>
  <div class="mt-6">
    <StoreButton storeUrl={addin.storeUrl} />
  </div>

  <h2 class="mt-10 text-2xl text-ink">Features</h2>
  <ul class="mt-3 list-disc space-y-1 pl-6">
    {addin.features.map((feature) => (
      <li>{feature}</li>
    ))}
  </ul>

  <h2 class="mt-10 text-2xl text-ink">How to use it</h2>
  <ol class="mt-3 list-decimal space-y-1 pl-6">
    {addin.howToUse.map((step) => (
      <li>{step}</li>
    ))}
  </ol>

  <h2 class="mt-10 text-2xl text-ink">Tips</h2>
  <ul class="mt-3 list-disc space-y-1 pl-6">
    {addin.tips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>

  <h2 class="mt-10 text-2xl text-ink">Requirements</h2>
  <p class="mt-2">Autodesk Fusion on Windows.</p>

  <p class="mt-12 text-sm">
    <a class="underline" href={`/#${group.slug}`}>
      &larr; Back to {group.name}
    </a>
    <span class="text-muted" aria-hidden="true">
      {' '}
      |{' '}
    </span>
    <a class="underline" href="/">
      All add-ins
    </a>
  </p>
</BaseLayout>

<script>
  // Go to the previous page when it was on this site; otherwise to the index.
  const backButton = document.getElementById('go-back');
  backButton?.addEventListener('click', () => {
    const cameFromSite =
      document.referrer !== '' &&
      new URL(document.referrer).origin === window.location.origin;
    if (cameFromSite && window.history.length > 1) {
      window.history.back();
    } else {
      window.location.href = '/';
    }
  });
</script>
