---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreButton from '../components/StoreButton.astro';
import { addins, getGroup } from '../data/addins';

export const getStaticPaths = (() =>
  addins.map((addin) => ({
    params: { slug: addin.slug },
    props: { addin },
  }))) satisfies GetStaticPaths;

const { addin } = Astro.props;
const group = getGroup(addin.group);
const pageUrl = new URL(`/${addin.slug}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${addin.name} for Fusion 360`,
  description: addin.tagline,
  url: pageUrl,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Windows',
  offers:
    addin.pricing === 'free'
      ? { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      : undefined,
  author: { '@type': 'Person', name: 'Richard McQuiston' },
};
---

<BaseLayout
  title={`${addin.name} for Fusion 360`}
  description={addin.tagline}
  jsonLd={jsonLd}
>
  <nav aria-label="Breadcrumb" class="text-sm">
    <a class="underline" href="/">
      &larr; Back to all add-ins
    </a>
    <span class="text-muted" aria-hidden="true">
      {' '}
      /{' '}
    </span>
    <a class="underline" href={`/#${group.slug}`}>
      {group.name}
    </a>
  </nav>
  <h1 class="mt-4 text-4xl text-ink">{addin.name}</h1>
  <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-muted">
    {addin.pricing === 'free' ? 'Free, with no limitations' : 'Paid'}
  </p>
  <p class="mt-4 max-w-2xl text-lg text-muted">{addin.description}</p>
  <div class="mt-6">
    <StoreButton storeUrl={addin.storeUrl} />
  </div>

  <h2 class="mt-10 text-2xl text-ink">Features</h2>
  <ul class="mt-3 list-disc space-y-1 pl-6">
    {addin.features.map((feature) => (
      <li>{feature}</li>
    ))}
  </ul>

  <h2 class="mt-10 text-2xl text-ink">How to use it</h2>
  <ol class="mt-3 list-decimal space-y-1 pl-6">
    {addin.howToUse.map((step) => (
      <li>{step}</li>
    ))}
  </ol>

  <h2 class="mt-10 text-2xl text-ink">Tips</h2>
  <ul class="mt-3 list-disc space-y-1 pl-6">
    {addin.tips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>

  <h2 class="mt-10 text-2xl text-ink">Requirements</h2>
  <p class="mt-2">Autodesk Fusion on Windows.</p>

  <p class="mt-12 text-sm">
    <a class="underline" href={`/#${group.slug}`}>
      &larr; Back to {group.name}
    </a>
    <span class="text-muted" aria-hidden="true">
      {' '}
      |{' '}
    </span>
    <a class="underline" href="/">
      All add-ins
    </a>
  </p>
</BaseLayout>
