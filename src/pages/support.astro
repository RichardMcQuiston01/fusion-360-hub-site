---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support | Fusion 360 Generators">
  <h1 class="text-3xl font-bold text-slate-900">Support</h1>
  <p class="mt-4 max-w-2xl">
    Questions, bug reports and feature requests are welcome. Contact details
    will be added here before the first add-in is published.
  </p>
  <h2 class="mt-8 text-xl font-semibold text-slate-900">Before you write</h2>
  <ul class="mt-2 list-disc space-y-1 pl-6">
    <li>Say which add-in and which version you are using.</li>
    <li>Say which version of Fusion you are using, and that it is Windows.</li>
    <li>Describe the settings you used and what you expected to happen.</li>
  </ul>
</BaseLayout>
