---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support | Fusion 360 Generators">
  <h1 class="text-4xl text-ink">Support</h1>
  <p class="mt-4 max-w-2xl">
    Questions, bug reports and feature requests are welcome. Email
    <a class="underline" href="mailto:fusion360@richardmcquiston.com">
      fusion360@richardmcquiston.com
    </a>
    .
  </p>
  <h2 class="mt-8 text-2xl text-ink">Before you write</h2>
  <ul class="mt-2 list-disc space-y-1 pl-6">
    <li>Say which add-in and which version you are using.</li>
    <li>Say which version of Fusion you are using, and that it is Windows.</li>
    <li>Describe the settings you used and what you expected to happen.</li>
  </ul>
</BaseLayout>
