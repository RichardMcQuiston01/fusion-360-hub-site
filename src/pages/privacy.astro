---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy | Fusion 360 Generators">
  <h1 class="text-3xl font-bold text-slate-900">Privacy</h1>
  <p class="mt-4 max-w-2xl">
    The free add-ins on this site collect no data and make no network calls.
    They run entirely inside Fusion on your computer.
  </p>
  <h2 class="mt-8 text-xl font-semibold text-slate-900">This website</h2>
  <p class="mt-2 max-w-2xl">
    This website is a set of static pages. It does not use cookies or analytics.
  </p>
  <p class="mt-4 max-w-2xl text-sm text-slate-600">
    If a future add-in sends any data, it will be described here and in that
    add-in's store listing before it is released.
  </p>
</BaseLayout>
