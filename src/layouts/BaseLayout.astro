---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description?: string;
  /** Structured data (schema.org) to embed on the page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'Fusion 360 add-ins for laser cutters, CNC routers and 3D printers.',
  jsonLd,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Add-ins' },
  { href: '/contact/', label: 'Contact Us' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/accessibility/', label: 'Accessibility' },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      Skip to main content
    </a>
    <header class="border-b border-border bg-surface">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
        <a
          id="site-title"
          href="/"
          class="font-heading text-xl font-bold text-ink no-underline"
        >
          Fusion 360 Generators
        </a>
        <nav aria-label="Main">
          <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium">
            {navLinks.map((link) => (
              <li>
                <a
                  class="inline-flex min-h-8 items-center text-ink no-underline underline-offset-4 hover:underline aria-[current=page]:font-bold aria-[current=page]:underline"
                  href={link.href}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-border bg-surface text-sm text-muted">
      <div class="mx-auto max-w-6xl px-4 py-6">
        <p>
          &copy; {year}
          <a class="underline" href="https://richardmcquiston.com/">
            Richard McQuiston
          </a>
          . All rights reserved. Autodesk and Fusion are trademarks of Autodesk,
          Inc. This site is not affiliated with Autodesk.
        </p>
      </div>
    </footer>
    <BackToTop />
  </body>
</html>
